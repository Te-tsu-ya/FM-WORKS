/* FM WORKS: related invoice, delivery and receipt documents.
   Only immutable issued quotations can be converted; no quote format mutation. */
const DOCUMENT_TYPES=Object.freeze({invoice:{label:'請求書',prefix:'INV'},delivery:{label:'納品書',prefix:'DEL'},receipt:{label:'領収書',prefix:'REC'}});
const DOCUMENT_KEYS=['id','kind','quoteId','requestKey','ownerId','ownerName','vendorCode','vendorName','vendorAddress','vendorInvoice','subject','quoteDate','documentDate','dueDate','paidDate','delivery','payment','expires','contact','note','bank','subtotal','taxAmount','total','linesJson','status','number','issuedAt','pdfFileId','xlsxFileId','updatedAt','confirmedBy'];
function documentType_(kind){const def=DOCUMENT_TYPES[String(kind||'')];if(!def)throw new Error('帳票種別が不正です。');return def;}
function documentStorageStatus_(){const names=['関連書類','関連書類採番'],missing=[];names.forEach(name=>{const sh=getDb_().getSheetByName(name),headers=DB_SCHEMA_SPECS[name];if(!sh||schemaHeaderIssues_(sh.getRange(1,1,1,headers.length).getDisplayValues()[0],headers).length)missing.push(name);});return {ready:!missing.length,missing};}
function documentSheet_(name){const sh=getDb_().getSheetByName(name),spec=DB_SCHEMA_SPECS[name];if(!sh||schemaHeaderIssues_(sh.getRange(1,1,1,spec.length).getDisplayValues()[0],spec).length)throw new Error('関連書類のDB更新が必要です。管理者がバックアップ付きDB更新を実施してください。');return sh;}
function documentObject_(values){const o={};DOCUMENT_KEYS.forEach((key,i)=>o[key]=values[i]==null?'':values[i]);return o;}
function documentArray_(obj){return DOCUMENT_KEYS.map(key=>obj[key]==null?'':obj[key]);}
function documentRows_(){const sh=documentSheet_('関連書類'),last=sh.getLastRow();return last<2?[]:sh.getRange(2,1,last-1,DOCUMENT_KEYS.length).getDisplayValues().map(documentObject_);}
function documentFind_(id){const sh=documentSheet_('関連書類'),last=sh.getLastRow();if(last<2)throw new Error('書類が見つかりません。');const found=sh.getRange(2,1,last-1,1).createTextFinder(String(id)).matchEntireCell(true).findNext();if(!found)throw new Error('書類が見つかりません。');const rowNumber=found.getRow(),raw=sh.getRange(rowNumber,1,1,DOCUMENT_KEYS.length).getDisplayValues()[0];if(raw[0]!==id)throw new Error('書類が移動されました。もう一度お試しください。');return {sheet:sh,rowNumber,record:documentObject_(raw)};}
function documentForUser_(user,record){if(!quoteIsAdmin_(user)&&String(record.ownerId)!==String(user.employeeId))throw new Error('この書類の閲覧権限がありません。');return record;}
function documentListForUser_(user,storageAlreadyValidated){
  if(!storageAlreadyValidated&&!documentStorageStatus_().ready)return [];
  return documentRows_().filter(x=>quoteIsAdmin_(user)||x.ownerId===user.employeeId)
    .sort((a,b)=>String(b.updatedAt).localeCompare(String(a.updatedAt))).slice(0,250)
    .map(x=>{const {linesJson,...y}=x;return y;});
}
function documentSnapshot_(record){let lines;try{lines=JSON.parse(record.linesJson);}catch(_){throw new Error('明細の読み込みに失敗しました。');}if(!Array.isArray(lines)||!lines.length||lines.length>QUOTE_MAX_LINES)throw new Error('明細の保存内容が不正です。');return {header:record,lines};}
function getRelatedDocument(sessionToken,id){const user=quoteUser_(sessionToken);return documentSnapshot_(documentForUser_(user,documentFind_(String(id)).record));}
function documentForm_(kind,p){documentType_(kind);const documentDate=financeDate_(p.documentDate,'発行日',true);let dueDate='',paidDate='';if(kind==='invoice')dueDate=financeDate_(p.dueDate,'支払期限',true);if(kind==='delivery')dueDate=financeDate_(p.dueDate,'納品日',true);if(kind==='receipt'){if(p.paidConfirmed!==true)throw new Error('領収書は入金を確認してから発行してください。');paidDate=financeDate_(p.paidDate,'入金日',true);if(paidDate>documentDate)throw new Error('入金日は発行日以前にしてください。');}return {documentDate,dueDate,paidDate,note:quoteText_(p.note,'備考',850,false)};}
function documentNumber_(kind,year,user){const def=documentType_(kind),sh=documentSheet_('関連書類採番'),last=sh.getLastRow(),rows=last<2?[]:sh.getRange(2,1,last-1,5).getDisplayValues(),index=rows.findIndex(x=>x[0]===kind&&x[1]===year);const previous=index<0?0:Number(rows[index][2]||0);if(!Number.isInteger(previous)||previous<0||previous>=9999)throw new Error('採番枠に空きがありません。');const next=previous+1,number=def.prefix+'-'+year+'-'+String(next).padStart(4,'0');if(documentRows_().some(x=>x.number===number))throw new Error('帳票番号が重複しています。');const data=[kind,year,next,quoteNow_(),user.employeeId];if(index<0)sh.appendRow(data);else sh.getRange(index+2,1,1,5).setValues([data]);return number;}
function documentReserve_(user,quoteId,kind,key,form){return withScriptLock_(function(){const h=quoteForUser_(user,quoteFind_('header',quoteId).data);if(h.status!=='発行済')throw new Error('先に見積書を正式発行してください。');if(!documentStorageStatus_().ready)throw new Error('関連帳票用DBが未初期化です。管理者がバックアップ付きDB更新を実施してください。');const all=documentRows_(),existing=all.find(x=>(x.quoteId===quoteId&&x.kind===kind)||x.requestKey===key);if(existing){documentForUser_(user,existing);if(existing.quoteId!==quoteId||existing.kind!==kind)throw new Error('送信識別子が別の帳票で使用されています。');return {created:false,record:existing};}const origin=quoteHeaderAndLines_(h),linesJson=JSON.stringify(origin.lines);if(linesJson.length>45000)throw new Error('明細が長すぎます。');const now=quoteNow_(),record={id:Utilities.getUuid(),kind,quoteId,requestKey:key,ownerId:h.ownerId,ownerName:h.ownerName,vendorCode:h.vendorCode,vendorName:h.vendorName,vendorAddress:h.vendorAddress,vendorInvoice:h.vendorInvoice,subject:h.subject,quoteDate:h.quoteDate,documentDate:form.documentDate,dueDate:form.dueDate,paidDate:form.paidDate,delivery:h.delivery,payment:h.payment,expires:h.expires,contact:h.contact,note:form.note||h.note,bank:h.bank,subtotal:Number(String(h.subtotal).replace(/,/g,'')),taxAmount:Number(String(h.taxAmount).replace(/,/g,'')),total:Number(String(h.total).replace(/,/g,'')),linesJson,status:'発行処理中',number:documentNumber_(kind,form.documentDate.slice(0,4),user),issuedAt:'',pdfFileId:'',xlsxFileId:'',updatedAt:now,confirmedBy:kind==='receipt'?user.employeeId:''};documentSheet_('関連書類').appendRow(documentArray_(record));appendAudit_({employeeId:user.employeeId,employeeName:user.name,operation:'関連帳票発行開始',target:DOCUMENT_TYPES[kind].label,targetId:record.id,before:'',after:auditJson_({number:record.number,quoteId,kind,total:record.total}),source:'WEB',result:'SUCCESS',note:''});return {created:true,record};},30000);}
function documentCreateFiles_(record){const type=documentType_(record.kind),data=documentSnapshot_(record),book=SpreadsheetApp.create('FM_WORKS_DOC_'+record.id),tempId=book.getId(),sheet=book.getSheets()[0],folderName='FM WORKS 正式発行書類',it=DriveApp.getFoldersByName(folderName),folder=it.hasNext()?it.next():DriveApp.createFolder(folderName),fileName=record.number+'_'+type.label;let pdf=null,xlsx=null;try{sheet.setName(type.label);const h=Object.assign({},record,{quoteDate:record.documentDate,number:record.number});quotePaintSheet_(sheet,h,data.lines);sheet.getRange('B1:E2').setValue(type.label);sheet.getRange('F2:G2').setValue('発行日：'+record.documentDate);sheet.getRange('H2:I2').setValue('書類番号：'+record.number);sheet.getRange('B13:E14').setValue(record.kind==='invoice'?'ご請求金額':record.kind==='receipt'?'領収金額':'納品金額');sheet.getRange('B8:E8').setValue(record.kind==='invoice'?'下記の通りご請求申し上げます。':record.kind==='receipt'?'下記の金額を領収いたしました。':'下記の通り納品いたします。');if(record.kind==='receipt'){sheet.getRange('B11').setValue('入金日');sheet.getRange('C11:E11').setValue(record.paidDate);sheet.getRange('B45:I45').setValue('上記金額を領収しました。 '+(record.note||''));}else{sheet.getRange('B11').setValue(record.kind==='invoice'?'支払期限':'納品日');sheet.getRange('C11:E11').setValue(record.dueDate);}SpreadsheetApp.flush();const base='https://docs.google.com/spreadsheets/d/'+tempId+'/export?',token=ScriptApp.getOAuthToken();function fetch(url,expected,mime){const res=UrlFetchApp.fetch(url,{method:'get',headers:{Authorization:'Bearer '+token},muteHttpExceptions:true}),bytes=res.getContent();if(res.getResponseCode()!==200||!bytes||bytes.length<100||bytes[0]!==expected[0]||bytes[1]!==expected[1])throw new Error('Google Sheets帳票出力に失敗しました（HTTP '+res.getResponseCode()+'）。');return res.getBlob().setContentType(mime);}const opt='format=pdf&size=7&portrait=true&fitw=true&gridlines=false&sheetnames=false&printtitle=false&fzr=false&top_margin=0.35&bottom_margin=0.35&left_margin=0.35&right_margin=0.35&gid='+sheet.getSheetId();pdf=folder.createFile(fetch(base+opt,[37,80],'application/pdf').setName(fileName+'.pdf'));xlsx=folder.createFile(fetch(base+'format=xlsx',[80,75],'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet').setName(fileName+'.xlsx'));return {pdfFileId:pdf.getId(),xlsxFileId:xlsx.getId()};}catch(err){if(pdf)pdf.setTrashed(true);if(xlsx)xlsx.setTrashed(true);throw err;}finally{DriveApp.getFileById(tempId).setTrashed(true);}}
function documentIssue_(user,record){let output;try{output=documentCreateFiles_(record);}catch(err){withScriptLock_(function(){const found=documentFind_(record.id),r=found.record;if(r.status==='発行処理中'&&r.number===record.number){r.status='出力失敗';r.updatedAt=quoteNow_();found.sheet.getRange(found.rowNumber,1,1,DOCUMENT_KEYS.length).setValues([documentArray_(r)]);}},30000);throw new Error('帳票出力に失敗しました。番号は保持されています。再試行してください：'+String(err.message||err));}return withScriptLock_(function(){const found=documentFind_(record.id),r=found.record;if(r.status!=='発行処理中'||r.number!==record.number)throw new Error('発行状態が変更されています。');r.status='発行済';r.issuedAt=quoteNow_();r.updatedAt=r.issuedAt;r.pdfFileId=output.pdfFileId;r.xlsxFileId=output.xlsxFileId;found.sheet.getRange(found.rowNumber,1,1,DOCUMENT_KEYS.length).setValues([documentArray_(r)]);appendAudit_({employeeId:user.employeeId,employeeName:user.name,operation:'関連帳票正式発行',target:DOCUMENT_TYPES[r.kind].label,targetId:r.id,before:auditJson_({status:record.status}),after:auditJson_({status:r.status,number:r.number,total:r.total}),source:'WEB',result:'SUCCESS',note:''});return {ok:true,id:r.id,number:r.number,status:r.status,kind:r.kind};},30000);}
function createRelatedDocument(token,quoteId,kind,payload){const user=quoteUser_(token),p=payload||{};documentType_(kind);const form=documentForm_(kind,p),key=quoteKey_(p.requestKey),reserved=documentReserve_(user,String(quoteId||''),kind,key,form);if(!reserved.created){const r=reserved.record;if(r.status==='発行済'&&r.pdfFileId&&r.xlsxFileId)return {ok:true,id:r.id,number:r.number,status:r.status,kind:r.kind,duplicate:true};throw new Error('この種類の書類がすでにあります。履歴で確認し、出力失敗時は再試行してください。');}return documentIssue_(user,reserved.record);}
function retryRelatedDocument(token,id){const user=quoteUser_(token),reserved=withScriptLock_(function(){const found=documentFind_(String(id)),r=documentForUser_(user,found.record);if(r.status==='発行済')return {ready:true,record:r};const then=Date.parse(String(r.updatedAt||'').replace(' ','T')+'+09:00');if(r.status!=='出力失敗'&&!(r.status==='発行処理中'&&Date.now()-then>900000))throw new Error('発行処理の完了を待ってください。');r.status='発行処理中';r.updatedAt=quoteNow_();found.sheet.getRange(found.rowNumber,1,1,DOCUMENT_KEYS.length).setValues([documentArray_(r)]);return {ready:false,record:r};},30000);return reserved.ready?{ok:true,id:reserved.record.id,number:reserved.record.number,status:'発行済',kind:reserved.record.kind}:documentIssue_(user,reserved.record);}
function getRelatedDocumentFile(token,id,format){const user=quoteUser_(token),r=documentForUser_(user,documentFind_(String(id)).record);if(format!=='pdf'&&format!=='xlsx')throw new Error('ファイル形式が不正です。');if(r.status!=='発行済')throw new Error('正式発行が完了していません。');const fileId=format==='pdf'?r.pdfFileId:r.xlsxFileId;if(!fileId)throw new Error('帳票ファイルが未保存です。');const f=DriveApp.getFileById(fileId);return {name:f.getName(),mimeType:f.getMimeType(),base64:Utilities.base64Encode(f.getBlob().getBytes())};}